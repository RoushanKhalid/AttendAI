# Application Settings
PROJECT_NAME="AI Face Recognition Attendance System"
ENVIRONMENT="development"
DEBUG=true
API_V1_STR="/api/v1"

# Security & Authentication
SECRET_KEY="temporary-dev-secret-change-in-production-ai-attendance-jwt"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings (PostgreSQL default, falls back to SQLite if unreachable)
DATABASE_URL="postgresql://postgres:root@localhost:5432/attendance_db"
USE_SQLITE_FALLBACK=true
SQLITE_URL="sqlite:///./attendance_dev.db"

# Redis Cache & Debounce (Falls back to thread-safe in-memory cache if unreachable)
REDIS_URL="redis://localhost:6379/0"

# Computer Vision & Recognition Parameters (Calibrated for SFace ONNX: Cosine >= 0.363 standard)
FACE_RECOGNITION_THRESHOLD=0.38
FACE_AMBIGUITY_MARGIN=0.08
LIVENESS_THRESHOLD=0.45
PUNCH_DEBOUNCE_SECONDS=60
MAX_FACE_DISTANCE_PX=120
MAX_YAW_ANGLE_DEG=20.0
MAX_PITCH_ANGLE_DEG=18.0

# Initial Admin Credentials
DEFAULT_ADMIN_EMAIL="admin@company.com"
DEFAULT_ADMIN_PASSWORD="admin123"
DEFAULT_ADMIN_NAME="System Administrator"

# Model Context Protocol (FastMCP)
MCP_SERVER_NAME="AttendAI MCP"
MCP_PATH="/mcp"
# Optional: auto-authenticate local stdio MCP sessions as this user email/username
# MCP_DEFAULT_USER_EMAIL="admin@company.com"
# Set true only if you intentionally want unauthenticated HTTP /mcp calls to use MCP_DEFAULT_USER_EMAIL
MCP_ALLOW_HTTP_DEFAULT_USER=false

